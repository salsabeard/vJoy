;
; vJoyVhf.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = vJoyVhf.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
vJoyVhf.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%vJoyVhf.DeviceDesc% = vJoyVhf_Device, Root\vJoyVhf ; TODO: edit hw-id

[vJoyVhf_Device.NT]
CopyFiles = File_Copy

[File_Copy]
vJoyVhf.sys

;-------------- Service installation
[vJoyVhf_Device.NT.Services]
AddService = vJoyVhf,%SPSVCINST_ASSOCSERVICE%, vJoyVhf_Service_Inst

; -------------- vJoyVhf driver install sections
[vJoyVhf_Service_Inst]
DisplayName    = %vJoyVhf.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\vJoyVhf.sys

[vJoyVhf_Device.NT.Wdf]
KmdfService = vJoyVhf, vJoyVhf_wdfsect

[vJoyVhf_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "vJoyVhf Installation Disk"
vJoyVhf.DeviceDesc = "vJoyVhf Device"
vJoyVhf.SVCDESC = "vJoyVhf Service"
